# Copier ce fichier en `.env` — `.env` est ignoré par git, jamais commité.

# --- Financial Modeling Prep ------------------------------------------
# La clé peut aussi être saisie directement dans l'application
# (panneau latéral -> Connexion), sans redémarrage.
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com/stable
FMP_RATE_LIMIT_PER_MIN=250

# --- Bloomberg (Desktop API) ------------------------------------------
# Aucune clé : la DAPI écoute en local et hérite des droits du Terminal ouvert.
ENABLE_BLOOMBERG=true
BLOOMBERG_HOST=localhost
BLOOMBERG_PORT=8194
BLOOMBERG_TIMEOUT_MS=20000
BLOOMBERG_BATCH_SIZE=100

# --- Sources secondaires ----------------------------------------------
ENABLE_YAHOO=true
OFFLINE_MODE=false          # true = aucun appel réseau, lecture du cache uniquement

# --- Réseau ------------------------------------------------------------
HTTP_TIMEOUT_S=15
HTTP_RETRIES=3
MAX_WORKERS=8

# --- Réseau d'entreprise (proxy d'inspection SSL) ----------------------
# Symptôme : toutes les sources échouent en même temps avec
# "certificate verify failed" / "self signed certificate in certificate chain".
#
# 1) Solution recommandée : le certificat racine de votre entreprise.
#    La vérification SSL reste active, le proxy est simplement reconnu.
# PI_CA_BUNDLE=/chemin/vers/entreprise.pem
#
# 2) Dépannage seulement : désactive la vérification des certificats.
#    Réseau d'entreprise de confiance uniquement, jamais un réseau public.
# PI_INSECURE_SSL=0
#
# REQUESTS_CA_BUNDLE et SSL_CERT_FILE sont également reconnues si votre
# équipe informatique les a déjà positionnées.
#
# Proxy explicite si nécessaire :
# HTTPS_PROXY=http://proxy.entreprise.local:8080
# NO_PROXY=localhost,127.0.0.1

# --- Cache -------------------------------------------------------------
CACHE_DIR=.cache
CACHE_TTL_QUOTES_S=300           # 5 min
CACHE_TTL_FUNDAMENTALS_S=86400   # 24 h
CACHE_TTL_CALENDAR_S=3600        # 1 h

# --- Application -------------------------------------------------------
BASE_CURRENCY=EUR
PORTFOLIOS_DIR=samples
LOG_LEVEL=INFO

# Hypothèses de modèle surchargées par fichier JSON (facultatif)
# MODEL_ASSUMPTIONS_FILE=config/assumptions.local.json
