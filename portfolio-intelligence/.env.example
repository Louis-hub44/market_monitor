# Copier ce fichier en `.env` — `.env` est ignoré par git, jamais commité.

# --- Financial Modeling Prep ------------------------------------------
# La clé peut aussi être saisie directement dans l'application
# (panneau latéral -> Connexion), sans redémarrage.
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com/stable
FMP_RATE_LIMIT_PER_MIN=250

# --- Sources secondaires ----------------------------------------------
ENABLE_YAHOO=true
OFFLINE_MODE=false          # true = aucun appel réseau, lecture du cache uniquement

# --- Réseau ------------------------------------------------------------
HTTP_TIMEOUT_S=15
HTTP_RETRIES=3
MAX_WORKERS=8

# --- Réseau d'entreprise (proxy d'inspection SSL) ----------------------
# Symptôme : toutes les sources échouent en même temps avec
# "certificate verify failed" / "self signed certificate in certificate chain".
#
# Toutes les requêtes passent par la session unique du terminal (core/).
# La vérification SSL n'est JAMAIS désactivée.
#
# 1) Par défaut : magasin de certificats du poste (paquet truststore), où
#    l'informatique a installé la racine du proxy. Aucune configuration.
# 2) Certificat racine de l'entreprise, ajouté au magasin du poste :
# PI_CA_BUNDLE=/chemin/vers/entreprise.pem      (ou TERMINAL_CA_BUNDLE)
#
# REQUESTS_CA_BUNDLE et SSL_CERT_FILE sont également reconnues.
#
# Proxy explicite si nécessaire :
# TERMINAL_HTTPS_PROXY=http://proxy.entreprise.local:8080
# TERMINAL_NO_PROXY=localhost,127.0.0.1
#
# Diagnostic : check-network

# --- Cache -------------------------------------------------------------
CACHE_DIR=.cache
CACHE_TTL_QUOTES_S=300           # 5 min
CACHE_TTL_FUNDAMENTALS_S=86400   # 24 h
CACHE_TTL_CALENDAR_S=3600        # 1 h

# --- Application -------------------------------------------------------
BASE_CURRENCY=EUR
PORTFOLIOS_DIR=samples
LOG_LEVEL=INFO

# Hypothèses de modèle surchargées par fichier JSON (facultatif)
# MODEL_ASSUMPTIONS_FILE=config/assumptions.local.json
