# Copier en .env (jamais commité). Les variables d'environnement réelles priment sur .env.
FMP_API_KEY=your_fmp_key_here

# Optionnel : chemin du config.yaml (sinon config/config.yaml du projet)
# MARKET_MONITOR_CONFIG=C:\path\to\config.yaml

# Optionnel : surcharge de l'ordre des providers (ex. à la maison, sans Terminal)
# MARKET_MONITOR_PROVIDERS=fmp,free

# Optionnel : proxy d'inspection SSL d'entreprise (Zscaler, Netskope...) - voir README § 4
# MARKET_MONITOR_CA_BUNDLE=C:\ProgramData\Zscaler\ZscalerRootCertificate.pem
# MARKET_MONITOR_INSECURE_SSL=1
