# Copy to .env (never commit .env). Read by rates_analytics.config.load_settings().
FMP_API_KEY=your_fmp_key_here
BLP_HOST=localhost
BLP_PORT=8194
# Optional: alternative config file
# RATES_ANALYTICS_CONFIG=C:\path\to\config.yaml

# --- Corporate network (SSL-inspection proxy: Zscaler, Netskope...) ---------------
# The dashboard asks on its start screen; these variables set the default for scripts / API.
# RATES_NETWORK_MODE=system          # standard | system (Windows store) | ca | insecure
# RATES_CA_BUNDLE=C:\ProgramData\Zscaler\ZscalerRootCertificate.pem   # forces mode "ca"
# Shared with Market Monitor (same .env for the whole terminal):
# MARKET_MONITOR_CA_BUNDLE=...
# MARKET_MONITOR_INSECURE_SSL=1
# Outbound proxy if the network requires one:
# HTTPS_PROXY=http://proxy.company.com:8080
