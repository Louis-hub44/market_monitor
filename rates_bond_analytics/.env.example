# Copy to .env (never commit .env). Read by rates_analytics.config.load_settings().
FMP_API_KEY=your_fmp_key_here
BLP_HOST=localhost
BLP_PORT=8194
# Optional: alternative config file
# RATES_ANALYTICS_CONFIG=C:\path\to\config.yaml

# --- Corporate network (SSL-inspection proxy: Zscaler, Netskope...) ---------------
# The dashboard asks on its start screen; these variables set the default for scripts / API.
# Shared by the whole terminal (core/terminal_core/network.py). Verification can NOT be disabled.
# TERMINAL_TRUST=auto                 # auto | system (Windows store) | ca | certifi
# TERMINAL_CA_BUNDLE=C:\ProgramData\Zscaler\ZscalerRootCertificate.pem   # added to the Windows store
# TERMINAL_HTTPS_PROXY=http://proxy.company.com:8080
# TERMINAL_NO_PROXY=localhost,.intranet.company.com
# Diagnostic: check-network
